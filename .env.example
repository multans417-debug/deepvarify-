APP_ENV=development
HOST=0.0.0.0
PORT=8000

DEVICE=auto

IMAGE_MODEL_PATH=models/image/best.pt
VIDEO_MODEL_PATH=models/video/best.pt

IMAGE_SIZE=224

FAKE_THRESHOLD=0.65
REAL_THRESHOLD=0.35

MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500

MAX_VIDEO_DURATION_SECONDS=300
TARGET_VIDEO_FRAMES=32
VIDEO_SAMPLING_STRATEGY=uniform

TOP_SUSPICIOUS_FRAMES=5

FACE_ONLY=true
FULL_IMAGE_FALLBACK=true
MAX_FACES=5

FRONTEND_ORIGINS=http://localhost:3000

RESULT_RETENTION_HOURS=24
PERSIST_UPLOADED_MEDIA=false
